# /etc/cron.d/recruit-reaper
# Weekly sweep of CV files no submission points at any more, left behind by a
# failed unlink during erasure or by an upload that died before its DB write.
# Edit the paths below to your checkout, then:
#   sudo cp scripts/recruit-reaper.cron /etc/cron.d/recruit-reaper
#   sudo chmod 644 /etc/cron.d/recruit-reaper
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Sunday 04:15 UTC. .env is sourced because the script needs DATABASE_URL and the
# Supabase keys from it. Output goes to a log rather than /dev/null: the script
# refuses to run when the CV bucket is unreachable or not this app's, and that
# refusal has to be visible.
15 4 * * 0 root cd /path/to/recruit && set -a && . ./.env && set +a && node --experimental-strip-types --no-warnings scripts/reap-orphan-uploads.mjs --apply >>/var/log/recruit-reaper.log 2>&1