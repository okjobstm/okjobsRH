# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database -------------------------------------------------------------
# Supabase Postgres session pooler (IPv4). The long-lived Next.js server uses
# transactions, so both runtime and migrations use session mode on port 5432.
# Use the database password, not the Supabase account password.
DATABASE_URL=postgresql://postgres.your-ref:your-db-password@aws-1-your-region.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.your-ref:your-db-password@aws-1-your-region.pooler.supabase.com:5432/postgres

# --- Supabase -------------------------------------------------------------
# Project URL and keys from Dashboard → Project Settings → API Keys.
# The publishable key is safe in the browser; the service-role key bypasses RLS
# and must never be prefixed with NEXT_PUBLIC_. Server-only: Storage access, and
# the Auth admin calls in tests/e2e/mint_admin_session.mjs.
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# The CV bucket is named in code (lib/supabase/storage.ts), not by env: create a
# private bucket called `cvs` in each project.

# --- Admin authentication -------------------------------------------------
# Email domain allowed to use the Admin role, e.g. example.com. Candidate and
# Company accounts accept any valid email address. An admin qualifies if the
# address matches this domain OR appears in ADMIN_EMAILS.
ADMIN_HOSTED_DOMAIN=example.com
# Optional: comma-separated emails to seed the reviewer picker before anyone has
# logged in. Lets you whitelist admins outside the hosted domain.
ADMIN_EMAILS=

# --- AI scoring -----------------------------------------------------------
# Required for AI rubric scoring of STAR behavioral responses.
# Uses the claude-sonnet-4-6 model via @anthropic-ai/sdk.
ANTHROPIC_API_KEY=sk-ant-...

# --- Branding / public copy ----------------------------------------------
# Public origin used to build candidate-facing links and report URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Names and contact email shown in the UI, privacy policy, and terms of use.
NEXT_PUBLIC_APP_NAME=Okjobs
NEXT_PUBLIC_ORG_NAME=Your Organization
NEXT_PUBLIC_CONTACT_EMAIL=privacy@example.com
# Locale and time zone used to format dates and deadlines in the candidate flow
# and in the admin views (defaults shown).
NEXT_PUBLIC_LOCALE=fr-FR
NEXT_PUBLIC_TIME_ZONE=Africa/Brazzaville

# --- Logging --------------------------------------------------------------
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# --- Error monitoring (optional) ------------------------------------------
# Sentry is a no-op unless these are set. See https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source-map upload:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
